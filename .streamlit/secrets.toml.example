# Streamlit Cloud secrets template.
# In Streamlit Cloud:
#   Your App → Settings → Secrets → paste the content below (without .example)
#
# For local dev, use .env instead of this file.

SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key-here"
SITE_URL = "https://your-app-name.streamlit.app"
