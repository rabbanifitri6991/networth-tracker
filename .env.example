# Copy this file to .env and fill in your Supabase credentials.
# .env is in .gitignore — it will never be committed to GitHub.

# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Your app URL (used for OAuth redirects)
# Local development:
SITE_URL=http://localhost:8501
# Production (replace with your actual Streamlit Cloud URL):
# SITE_URL=https://your-app-name.streamlit.app
